# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project: wmxfomqysadfmbxequsx
NEXT_PUBLIC_SUPABASE_URL=https://wmxfomqysadfmbxequsx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Dashboard -> Project Settings -> Database -> Connection string (use the "Transaction pooler" URI)
DATABASE_URL=

# The single admin's login email (must match a user created in Supabase Auth)
ADMIN_EMAIL=

# Public site URL, used for metadata/sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Motion kill-switch (docs/improvement-plan/08-workstream-motion-3d.md):
#   full = Lenis smooth scroll + scroll-scrubbed GSAP choreography (default)
#   lite = native scroll, cheap time-based entrance animations only
#   off  = fully static site, no JS-driven motion
# Demote to "lite"/"off" instantly if analytics show scroll jank on mobile.
NEXT_PUBLIC_MOTION_LEVEL=full
# Search-engine site verification (Task 3.1, docs/improvement-plan/03-workstream-seo.md)
# Google Search Console -> Settings -> Ownership verification -> HTML tag (content value only)
GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor (searchadvisor.naver.com) -> 사이트 소유확인 -> HTML 태그 (content value only)
NAVER_SITE_VERIFICATION=
